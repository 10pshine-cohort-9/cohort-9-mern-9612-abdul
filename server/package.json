{
  "name": "notes-app-backend",
  "version": "1.0.0",
  "description": "Backend for Notes App",
  "main": "src/server.js",
  "type": "module",
  "scripts": {
    "start": "node src/server.js",
    "dev": "nodemon src/server.js",
    "test": "mocha",
    "test:coverage": "c8 --reporter=text --reporter=lcov mocha"
  },
  "c8": {
    "include": [
      "src/**/*.js"
    ],
    "exclude": [
      "tests/**",
      "src/database/create_revoked_tokens.mjs"
    ],
    "report-dir": "coverage",
    "all": true
  },
  "dependencies": {
    "bcryptjs": "^3.0.3",
    "cors": "^2.8.6",
    "dotenv": "^16.4.5",
    "express": "^4.21.0",
    "jsonwebtoken": "^9.0.3",
    "pg": "^8.22.0",
    "pino": "^10.3.1",
    "pino-http": "^11.0.0"
  },
  "devDependencies": {
    "c8": "^10.1.3",
    "chai": "^5.1.2",
    "mocha": "^11.1.0",
    "nodemon": "^3.1.4",
    "pino-pretty": "^13.1.3",
    "supertest": "^7.0.0"
  }
}
